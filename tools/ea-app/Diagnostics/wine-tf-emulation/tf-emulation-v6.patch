+static void tf_set_sigcontext( const CONTEXT *context, ucontext_t *sigcontext )
+{
+    set_sigcontext( context, sigcontext );
+    if (tf_emulation && (amd64_thread_data()->tf_state & TF_CARRIER)) EFL_sig(sigcontext) |= 0x100;
+}
+
+static void tf_arm_frame( struct syscall_frame *frame, DWORD flags, const CONTEXT *context )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    DWORD guest = (flags & CONTEXT_CONTROL) ? context->EFlags : tf_guest_flags( frame->eflags );
+
+    if (!tf_emulation) return;
+    data->tf_guest_flags = guest & TF_GUEST_BITS;
+    data->tf_state = 0;
+    frame->eflags = guest;
+    if ((data->dr7 & 0xff) || (guest & 0x100))
+    {
+        tf_budget();
+        data->tf_state = TF_CARRIER | TF_BOUNDARY;
+        frame->eflags |= 0x100;
+        frame->restore_flags |= CONTEXT_CONTROL;
+    }
+}
