  "renderers": [
    {
      "api": "dxgi",
      "backend": "dxmt",
      "executable": "bf3.exe",
      "reason": "Measured: the campaign ran windowed for 8+ minutes on DXMT with the d3d11 proxy"
    },
    {
      "api": "dxgi",
      "backend": "dxmt",
      "executable": "BF3WebHelper.exe",
      "reason": "Measured: without a rule it failed to import dxgi and d3d11 and quit"
    },
    {
      "api": "dxgi",
      "backend": "dxmt",
      "executable": "EALaunchHelper.exe",
      "reason": "Measured: without a rule it failed to import dxgi and d3d11"
    },
    {
      "api": "dxgi",
      "backend": "dxmt",
      "executable": "EAGEP.exe",
      "reason": "As the other EA helpers: it imports dxgi, which only DXMT supplies here"
    },
    {
      "api": "dxgi",
      "backend": "dxmt",
      "executable": "EADesktop.exe",
      "reason": "Measured with NFS 2015: renders the full client UI with none of the shared-handle failures D3DMetal logs"
    },
    {
      "api": "dxgi",
      "backend": "dxmt",
      "executable": "EACefSubProcess.exe",
      "reason": "Measured with NFS 2015: its libcef.dll imports dxgi.dll, which no other backend supplies here"
    }
  ],
  "prefixRegistry": [
    {
      "hive": "system.reg",
      "path": "Software\\Wow6432Node\\EA Games\\Battlefield 3",
      "name": "Install Dir",
      "reason": "The registration EA's installer wrote, so the EA app finds the packaged game"
    },
    {
      "hive": "system.reg",
      "path": "Software\\Wow6432Node\\EA Games\\Battlefield 3",
      "name": "GDFBinary",
      "reason": "Game Explorer registration that the game's finalize step (Touchup) checks"
    },
    {
      "hive": "system.reg",
      "path": "Software\\Classes\\CLSID\\{9BA05972-F6A8-11CF-A442-00A0C90A8F39}\\InprocServer32",
      "reason": "CLSID_ShellWindows stand-in (shellwin.dll): Wine's ieframe lacks it and BF3WebHelper.exe and bf3.exe quit with 0x80040111"
    },
    {
      "hive": "system.reg",
      "path": "Software\\Classes\\PROTOCOLS\\Handler\\res",
      "reason": "The res:// protocol handler the Game Explorer registration needs (provided by mshtml with Wine Gecko)"
    },
    {
      "hive": "user.reg",
      "path": "Software\\Wine\\AppDefaults\\bf3.exe\\DllOverrides",
      "name": "d3d11",
      "reason": "Loads the game-folder d3d11 proxy for bf3.exe only (native,builtin)"
    },
    {
      "hive": "system.reg",
      "path": "Software\\Wine\\AppDefaults\\bf3.exe\\DllOverrides",
      "name": "d3d11",
      "reason": "The same override in the machine hive, as the bring-up set it"
    },
    {
      "hive": "system.reg",
      "path": "System\\ControlSet001\\Services\\PnkBstrA",
      "reason": "PunkBuster's service, present as EA's installer registered it; the app stops it with the prefix"
    }
  ],
  "gameShims": [
    {
      "path": "d3d11.dll",
      "sha256": "79a1aaf6fb3823d636e97888c6f5d8b5342f1af51bd7b20356812c1499727a57",
      "reason": "32-bit proxy that forwards to DXMT and returns a view on a same-size texture when DXMT rejects a render-target view on a buffer (the game's DirectX Error); buffer contents are not preserved; source in Sources/bf3-prefix-src"
    }
  ],
